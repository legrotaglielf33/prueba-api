{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Iniciar El \"Santi\"-Grial (servidor + navegador)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/servidor.js",
      "serverReadyAction": {
        "pattern": "http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
